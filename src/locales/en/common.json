  "about": {
    "hero": {
      "badge": "MODULE · Visa Experience Layer",
      "titleLine1": "Visa journeys designed by humans,",
      "titleHighlight": "simplified",
      "titleLine2": "for every kind of traveller.",
      "subtitle": "Helloviza is a visa and travel support layer built for real life. Business, family, study or a quick getaway — we focus on clarity, timelines and calm, not paperwork panic.",
      "chips": {
        "visaOs": "Visa-first travel operating layer",
        "humanExperts": "Human support + structured process",
        "travelConfidence": "Decisions made with confidence"
      },
      "panel": {
        "labelLeft": "MODULE · Live visa support",
        "labelRight": "ACTIVE",
        "title": "Where does Helloviza fit?",
        "body": "Think of us as a calm control room for your visa journey. We translate embassy requirements into simple checklists, keep you posted on progress and help you react quickly when plans shift."
      },
      "metrics": {
        "onTime": {
          "big": "99.2%",
          "label": "visas delivered before travel date*"
        },
        "travelers": {
          "big": "10k+",
          "label": "travellers guided across journeys"
        },
        "countries": {
          "big": "40+",
          "label": "countries and routes supported"
        }
      }
    },
    "images": {
      "handAlt": "Animated hand illustration",
      "globeAlt": "Illustration of global travel routes",
      "circleAlt": "Circular travel illustration"
    },
    "visionMission": {
      "moduleLabelLeft": "MODULE · Vision / Mission",
      "moduleLabelRight": "SYSTEM LAYER // PURPOSE"
    },
    "vision": {
      "titleTag": "VISION",
      "title": "A visa layer that feels human, not bureaucratic.",
      "body1": "Our vision is to make cross-border travel feel intuitive, transparent and safe — no matter which consulate, route or reason you are travelling for.",
      "body2": "We imagine a world where travellers understand what is happening with their application at every step, and never feel alone in the process."
    },
    "mission": {
      "titleTag": "MISSION",
      "title": "Remove friction from every visa journey.",
      "body1": "Helloviza’s mission is to turn confusing forms, scattered documents and shifting rules into a guided, step-by-step experience.",
      "body2": "From discovery to stamping and beyond, we align people, processes and technology around what actually matters: timelines, safety and peace of mind."
    },
    "origin": {
      "moduleLabelLeft": "MODULE · Origin Story",
      "moduleLabelRight": "SYSTEM LOG // CONTEXT",
      "title": "Why Helloviza exists",
      "body1": "Helloviza grew out of years of helping friends, families and partners navigate visas the hard way — inconsistent information, last-minute document scrambles and nervous checks for status updates.",
      "bullets": [
        "forms that change from one consulate to another.",
        "checklists buried inside PDFs and email threads.",
        "unclear status updates and surprise document asks.",
        "travellers discovering rules only at the airport counter."
      ],
      "body2": "We built Helloviza to be the opposite of that: a single place where the requirements are clear, your documents live together and a real human can step in when it feels overwhelming."
    },
    "howWeHelp": {
      "kicker": "HOW HELLOVIZA HELPS",
      "body": "Instead of one-off answers, we build a repeatable, structured layer around every visa journey.",
      "cards": {
        "guidedVisa": {
          "title": "Guided visa discovery",
          "body": "Understand which visa fits your purpose of travel, timelines and basic requirements — in plain language."
        },
        "documentLayer": {
          "title": "Structured document layer",
          "body": "Upload, name and track documents in one place so nothing is lost between drives, emails and chats."
        },
        "statusClarity": {
          "title": "Status & milestone clarity",
          "body": "Know where your application stands, what is pending and what comes next — without decoding jargon."
        },
        "globalAssist": {
          "title": "Global-ready support",
          "body": "Across embassies, time zones and changing rules, our team helps you react quickly when plans or policies shift."
        }
      }
    },
    "global": {
      "moduleLabelLeft": "MODULE · Global Layer",
